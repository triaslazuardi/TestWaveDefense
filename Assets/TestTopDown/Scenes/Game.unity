--- !u!114 &1121486566
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1121486564}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 48127ce3f378eee4788301b5ee65cb86, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  pages:
  - title: Your goal
    body: "Defend your Core from waves of enemies. \\n Survive all 3 waves to win.
      \\n If the Core\u2019s HP reaches 0, you lose."
  - title: Build phase
    body: Pick a structure at the bottom left, then click an empty slot to place
      it. \n Each structure costs Gold.\n Right-click to cancel your selection.
  - title: Structures
    body: 'Wall: blocks enemies and soaks up damage.\n Turret: shoots enemies in
      range.\n Generator: gives bonus Gold after every wave.'
  - title: Defend phase
    body: Press Start Wave when you are ready.\n Your structures fight on their own,
      but you cannot build during a wave.\n Clear the wave to earn Gold, then build
      again.
  - title: Tips
    body: 'Put Walls on the path to hold enemies inside Turret range.\n Build Generators
      early so they pay off. \n Do not spam one type: mix Turrets, Walls and Generators.'
  parentPanel: {fileID: 724521969}
  titleText: {fileID: 808503614}
  bodyText: {fileID: 1143148117}
  pageText: {fileID: 1784898184}
  prevButton: {fileID: 338591476}
  nextLabel: {fileID: 1698005088}
